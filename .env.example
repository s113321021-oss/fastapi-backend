# App settings
APP_NAME=fastapi-backend
DEBUG=True
SECRET_KEY=change-me-to-a-strong-secret-key

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/fastapi_db

# Reverse proxy / subpath deployment prefix
# Must match the public URL prefix, for example:
# https://demo.wke.csie.ncnu.edu.tw/s113321021/docs
ROOT_PATH=/s113321021

# Optional: CORS
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Optional: JWT / auth
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60