# App settings
APP_NAME=fastapi-backend
DEBUG=True
SECRET_KEY=change-me-to-a-strong-secret-key
# Replace with a unique random value of at least 32 characters before deployment.

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/fastapi_db
# Optional: disposable database for integration tests
# TEST_DATABASE_URL=postgresql://username:password@localhost:5432/fastapi_test

# Reverse proxy / subpath deployment prefix
# Must match the public URL prefix, for example:
# https://demo.wke.csie.ncnu.edu.tw/s113321021/docs
ROOT_PATH=/s113321021

# Trust X-Forwarded-* headers only when running behind a trusted reverse proxy.
# Leave false unless the proxy strips/overwrites forwarded headers.
TRUST_PROXY_HEADERS=False

# Disable interactive API docs in production unless explicitly needed.
ENABLE_DOCS=True

# Optional: CORS
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Optional: JWT / auth
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Session cookies default to Secure. Set False only for local HTTP development.
SESSION_COOKIE_SECURE=False

# Registration QR token TTL in seconds (default: 600, allowed: 30-86400)
# REGISTRATION_QR_TTL_SECONDS=600
